use tally::amount;

#[test]
fn point_one_and_point_two_make_point_three() {
    let sum = amount::parse("0.10").unwrap() + amount::parse("0.20").unwrap();
    assert_eq!(sum, amount::parse("0.30").unwrap());
}

#[test]
fn more_than_two_decimals_are_refused() {
    assert!(amount::parse("1.005").is_err());
}

#[test]
fn an_amount_too_large_to_hold_is_refused() {
    assert!(amount::parse("92233720368547758.07").is_ok());
    assert!(amount::parse("92233720368547758.08").is_err());
}

#[test]
fn an_amount_is_written_with_two_decimals() {
    assert_eq!(amount::format(-1250), "-12.50");
    assert_eq!(amount::format(5), "0.05");
}

/// Reference: the decimal notation the ledger is written in, which `str::parse::<f64>` read before this change: `12.5`
/// and `12.50` are one amount.
#[test]
fn one_decimal_is_tenths() {
    assert_eq!(amount::parse("12.5").unwrap(), amount::parse("12.50").unwrap());
}

