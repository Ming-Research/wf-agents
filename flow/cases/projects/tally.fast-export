mark :12
data 718
//! Ledgers in the format before 0.3: `date;amount;category`, semicolons, no header and no note.
//!
//! Kept so that `tally import-legacy` can convert an old ledger into the current format; every ledger the owner keeps
//! was converted in 0.3.

use crate::entry::Entry;
use crate::ledger::Ledger;

/// Reads a ledger of the old format.
pub fn import(text: &str) -> Result<Ledger, String> {
    let mut entries = Vec::new();
    for (i, line) in text.lines().enumerate() {
        if line.trim().is_empty() {
            continue;
        }
        let converted = line.replace(';', ",");
        entries.push(Entry::parse(&converted).map_err(|e| format!("line {}: {e}", i + 1))?);
    }
    Ok(Ledger { entries })
}

