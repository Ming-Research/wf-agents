//! The ledger: every entry of the file, in the order the file holds them.

use std::collections::BTreeMap;

use crate::amount::Amount;
use crate::entry::Entry;

/// The first line of every ledger file.
pub const HEADER: &str = "date,amount,category,note";

#[derive(Clone, Debug, Default, PartialEq)]
pub struct Ledger {
    pub entries: Vec<Entry>,
}

impl Ledger {
    /// Reads a ledger file: the header, then an entry a line; blank lines are skipped. A line that cannot be read
    /// fails the whole file, saying its number (principle no-silent-skips).
    pub fn parse(text: &str) -> Result<Ledger, String> {
        let mut lines = text.lines().enumerate();
        match lines.next() {
            Some((_, first)) if first.trim() == HEADER => {}
            _ => return Err(format!("the first line is not {HEADER:?}")),
        }
        let mut entries = Vec::new();
        for (i, line) in lines {
            if line.trim().is_empty() {
                continue;
            }
            entries.push(Entry::parse(line).map_err(|e| format!("line {}: {e}", i + 1))?);
        }
        Ok(Ledger { entries })
    }

    /// Everything spent, less what came back.
    pub fn total(&self) -> Amount {
        self.entries.iter().map(|e| e.amount).sum()
    }

    /// What was spent in each category, by the category's name.
    pub fn by_category(&self) -> BTreeMap<String, Amount> {
        let mut sums = BTreeMap::new();
        for e in &self.entries {
            *sums.entry(e.category.clone()).or_insert(0.0) += e.amount;
        }
        sums
    }

    /// The entries of one category, in the order the file holds them. A category no entry has fails, naming it, so
    /// that a mistyped name is not read as no spending (Article 2).
    pub fn only(&self, category: &str) -> Result<Ledger, String> {
        let entries: Vec<Entry> = self
            .entries
            .iter()
            .filter(|e| e.category == category)
            .cloned()
            .collect();
        if entries.is_empty() {
            return Err(format!("no entry has the category {category:?}"));
        }
        Ok(Ledger { entries })
    }

    /// The ledger written as a file again, header first.
    pub fn write(&self) -> String {
        let mut out = String::from(HEADER);
        out.push('\n');
        for e in &self.entries {
            out.push_str(&format!("{},{},{},{}\n", e.date, e.amount, e.category, e.note));
        }
        out
    }
}

