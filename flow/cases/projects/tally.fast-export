data 1047
use tally::Ledger;

const FILE: &str = "date,amount,category,note
2026-01-05,12.50,food,lunch
2026-01-07,40,transport,train pass
2026-01-09,-12.50,food,refund, lunch was cancelled
";

#[test]
fn a_ledger_reads_every_line() {
    let ledger = Ledger::parse(FILE).unwrap();
    assert_eq!(ledger.entries.len(), 3);
    assert_eq!(ledger.entries[2].note, "refund, lunch was cancelled");
}

#[test]
fn total_subtracts_refunds() {
    assert_eq!(Ledger::parse(FILE).unwrap().total(), 40.0);
}

#[test]
fn by_category_sums_each_category() {
    let sums = Ledger::parse(FILE).unwrap().by_category();
    assert_eq!(sums["food"], 0.0);
    assert_eq!(sums["transport"], 40.0);
}

#[test]
fn a_line_that_cannot_be_read_fails_the_file() {
    let err = Ledger::parse("date,amount,category,note\n2026-01-05,twelve,food,\n").unwrap_err();
    assert!(err.starts_with("line 2:"), "{err}");
}

#[test]
fn a_ledger_written_reads_back_the_same() {
    let ledger = Ledger::parse(FILE).unwrap();
    assert_eq!(Ledger::parse(&ledger.write()).unwrap(), ledger);
}

