#[test]
fn only_fails_on_a_category_no_entry_has() {
    let err = Ledger::parse(FILE).unwrap().only("fod").unwrap_err();
    assert_eq!(err, "no entry has the category \"fod\"");
}

/// Reference: `Ledger::parse` keeps the order of the file (`a_ledger_reads_every_line`), and the plan's `only` keeps the
/// entries of one category in that order.
#[test]
fn only_keeps_the_order_of_the_file() {
    let ledger = Ledger::parse(
        "date,amount,category,note
2026-01-07,40,transport,train pass
2026-01-05,12.50,food,lunch
2026-01-03,7,food,coffee
",
    )
    .unwrap();
    let notes: Vec<String> = ledger
        .only("food")
        .unwrap()
        .entries
        .into_iter()
        .map(|e| e.note)
        .collect();
    assert_eq!(notes, ["lunch", "coffee"]);
}

/// Reference: `Ledger::by_category`, the sums `tally categories` prints, where `foo` and `food` are two categories.
#[test]
fn only_keeps_a_category_apart_from_one_it_begins() {
    let ledger = Ledger::parse(
        "date,amount,category,note
2026-01-05,10,foo,
2026-01-06,20,food,
",
    )
    .unwrap();
    assert_eq!(ledger.only("foo").unwrap().entries.len(), 1);
}

#[test]
fn only_ignores_the_case_of_the_category() {
    let ledger = Ledger::parse(
        "date,amount,category,note
2026-01-05,10,Food,
2026-01-06,20,food,
",
    )
    .unwrap();
    assert_eq!(ledger.only("food").unwrap().entries.len(), 2);
}

