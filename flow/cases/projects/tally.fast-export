mark :14
data 738
//! The reports made from a ledger.

use std::collections::BTreeMap;

use crate::amount::{self, Amount};
use crate::ledger::Ledger;

/// What was spent in each month, as `YYYY-MM`, the months in order.
pub fn monthly(ledger: &Ledger) -> Vec<(String, Amount)> {
    let mut months: BTreeMap<String, Amount> = BTreeMap::new();
    for e in &ledger.entries {
        let month = e.date[..6].to_string();
        *months.entry(month).or_insert(0.0) += e.amount;
    }
    months.into_iter().collect()
}

/// A report's rows as text: a row a line, the key, two spaces, the amount.
pub fn render(rows: &[(String, Amount)]) -> String {
    rows.iter()
        .map(|(key, sum)| format!("{key}  {}\n", amount::format(*sum)))
        .collect()
}

