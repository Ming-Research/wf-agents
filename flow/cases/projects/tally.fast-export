data 2022
//! An amount of money, in the ledger's one currency, as a whole number of cents (decision amounts-are-cents).

/// An amount in cents, positive for what was spent and negative for what came back, such as a refund.
pub type Amount = i64;

/// Reads an amount as the ledger writes it, into cents: digits with an optional sign and at most two decimals, such as
/// `12.50` or `-3`. More than two decimals are refused rather than rounded, and an amount past what an `Amount` holds
/// rather than wrapped (Article 2).
pub fn parse(text: &str) -> Result<Amount, String> {
    let bad = || format!("not an amount: {text:?}");
    let too_large = || format!("an amount past what tally holds: {text:?}");
    let trimmed = text.trim();
    let (negative, digits) = match trimmed.strip_prefix('-') {
        Some(rest) => (true, rest),
        None => (false, trimmed),
    };
    let (units, decimals) = digits.split_once('.').unwrap_or((digits, ""));
    let all_digits = |s: &str| s.bytes().all(|b| b.is_ascii_digit());
    if units.is_empty() || !all_digits(units) || !all_digits(decimals) || decimals.len() > 2 {
        return Err(bad());
    }
    let units: i64 = units.parse().map_err(|_| too_large())?;
    let cents: i64 = format!("{decimals:0<2}").parse().map_err(|_| bad())?;
    let sign = if negative { -1 } else { 1 };
    units
        .checked_mul(100 * sign)
        .and_then(|whole| whole.checked_add(cents * sign))
        .ok_or_else(too_large)
}

/// Writes an amount with two decimals, as the ledger and every report show it.
pub fn format(amount: Amount) -> String {
    let sign = if amount < 0 { "-" } else { "" };
    let cents = amount.unsigned_abs();
    format!("{sign}{}.{:02}", cents / 100, cents % 100)
}

/// The sum of two amounts, refused rather than wrapped where it is past what an `Amount` holds (Article 2).
pub fn add(a: Amount, b: Amount) -> Result<Amount, String> {
    a.checked_add(b)
        .ok_or_else(|| format!("a sum past what tally holds: {} and {}", format(a), format(b)))
}

