//! The `tally` command: reads a ledger file and prints what is asked of it.

use std::process::ExitCode;

use tally::{amount, legacy, report, Ledger};

const USAGE: &str = "usage: tally total FILE | tally categories FILE | tally report --monthly [--category NAME] FILE | tally import-legacy OLD NEW";

fn main() -> ExitCode {
    let args: Vec<String> = std::env::args().skip(1).collect();
    match run(&args) {
        Ok(out) => {
            print!("{out}");
            ExitCode::SUCCESS
        }
        Err(e) => {
            eprintln!("tally: {e}");
            ExitCode::FAILURE
        }
    }
}

fn run(args: &[String]) -> Result<String, String> {
    let read = |path: &str| std::fs::read_to_string(path).map_err(|e| format!("{path}: {e}"));
    match args.iter().map(String::as_str).collect::<Vec<_>>().as_slice() {
        ["total", file] => Ok(format!("{}\n", amount::format(Ledger::parse(&read(file)?)?.total()))),
        ["categories", file] => {
            let sums = Ledger::parse(&read(file)?)?.by_category();
            Ok(sums
                .iter()
                .map(|(c, s)| format!("{c}  {}\n", amount::format(*s)))
                .collect())
        }
        ["report", "--monthly", file] => Ok(report::render(&report::monthly(&Ledger::parse(&read(file)?)?))),
        ["report", "--monthly", "--category", category, file] => {
            let ledger = Ledger::parse(&read(file)?)?.only(category)?;
            Ok(report::render(&report::monthly(&ledger)))
        }
        ["import-legacy", old, new] => {
            let ledger = legacy::import(&read(old)?)?;
            std::fs::write(new, ledger.write()).map_err(|e| format!("{new}: {e}"))?;
            Ok(format!("{} entries written to {new}\n", ledger.entries.len()))
        }
        _ => Err(USAGE.to_string()),
    }
}

