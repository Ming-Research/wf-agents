# The measurement `system-read-build`: how long it takes to build the test `system_read` of the web crate's routes, which
# adds a hundred works through the engine and reads the system over them once, and to run it, as it runs in the checkout
# this script is run in (`measure/` of the measure workflow, `.github/workflows/measure.yml`). The measurement
# `system-read` runs this with many reads more, so the time of the reads is its time less this one's. The test is copied
# into a checkout that lacks it, the code the work's change began from among them, so that each side reads the system
# over the same works.
set -euo pipefail
# The runner's own path holds no cargo or node; the project's machine keeps them with rustup and in /opt/node, as the
# project's workflows put them on the path.
export PATH="$HOME/.cargo/bin:/opt/node/bin:$PATH"
# The page is built into the command (crates/web/build.rs), and a checkout of the measure workflow has none built: build
# it as the project's workflows do, once for the checkout, so that the build after it finds it.
if [ ! -f client/dist/index.html ]; then
  (cd client && npm ci --no-audit --no-fund && npm run build)
fi
routes=crates/web/tests/routes
candidate="$(cd "$(dirname "$0")/.." && pwd -P)"
if [ "$candidate" != "$(pwd -P)" ]; then
  cp "$candidate/$routes/system_read.rs" "$routes/system_read.rs"
  grep -qx 'mod system_read;' "$routes/main.rs" || sed -i 's/^mod system;$/mod system;\nmod system_read;/' "$routes/main.rs"
fi
SYSTEM_READS="${SYSTEM_READS:-0}" cargo test --locked -p web --test routes -- --ignored --exact \
  system_read::the_system_is_read_over_a_hundred_merged_works > /dev/null
