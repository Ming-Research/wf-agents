mark :10
data 1496
//! One line of the ledger: `date,amount,category,note`.

use crate::amount::{self, Amount};

/// What was spent on one day, in one category.
#[derive(Clone, Debug, PartialEq)]
pub struct Entry {
    /// The day, as `YYYY-MM-DD`.
    pub date: String,
    pub amount: Amount,
    pub category: String,
    /// Free text; may be empty.
    pub note: String,
}

impl Entry {
    /// Reads one line of the ledger. The note is everything after the third comma, commas included.
    pub fn parse(line: &str) -> Result<Entry, String> {
        let mut fields = line.splitn(4, ',');
        let date = fields.next().unwrap_or("").trim();
        let amount = fields.next().ok_or_else(|| format!("no amount: {line:?}"))?;
        let category = fields.next().ok_or_else(|| format!("no category: {line:?}"))?;
        let note = fields.next().unwrap_or("");
        if !is_date(date) {
            return Err(format!("not a date as YYYY-MM-DD: {date:?}"));
        }
        Ok(Entry {
            date: date.to_string(),
            amount: amount::parse(amount)?,
            category: category.trim().to_string(),
            note: note.trim().to_string(),
        })
    }
}

/// Whether the text is a date as `YYYY-MM-DD`: ten characters, digits but for the two dashes.
fn is_date(text: &str) -> bool {
    let bytes = text.as_bytes();
    bytes.len() == 10
        && bytes.iter().enumerate().all(|(i, b)| match i {
            4 | 7 => *b == b'-',
            _ => b.is_ascii_digit(),
        })
}

