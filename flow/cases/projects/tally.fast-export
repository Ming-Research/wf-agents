use tally::{report, Ledger};

#[test]
fn monthly_sums_a_month() {
    let ledger = Ledger::parse(
        "date,amount,category,note
2026-10-01,10,food,
2026-10-20,20,food,
",
    )
    .unwrap();
    let rows = report::monthly(&ledger);
    assert_eq!(rows.len(), 1);
    assert_eq!(rows[0].1, 30.0);
}

#[test]
fn render_writes_a_row_a_line() {
    let rows = vec![("food".to_string(), 12.5), ("rent".to_string(), 800.0)];
    assert_eq!(report::render(&rows), "food  12.50\nrent  800.00\n");
}

#[test]
fn monthly_of_one_category() {
    let ledger =
        Ledger::parse("date,amount,category,note\n2026-01-05,10,food,\n2026-01-06,99,rent,\n2026-02-01,5,food,\n")
            .unwrap()
            .only(&["food"])
            .unwrap();
    let rows = report::monthly(&ledger);
    assert_eq!(rows, vec![("2026-01".to_string(), 10.0), ("2026-02".to_string(), 5.0)]);
}

#[test]
fn monthly_of_two_categories() {
    let ledger = Ledger::parse(
        "date,amount,category,note
2026-01-05,10,food,
2026-01-06,99,rent,
2026-01-09,7,books,
2026-02-01,5,food,
",
    )
    .unwrap()
    .only(&["food", "books"])
    .unwrap();
    let rows = report::monthly(&ledger);
    assert_eq!(rows, vec![("2026-01".to_string(), 17.0), ("2026-02".to_string(), 5.0)]);
}

