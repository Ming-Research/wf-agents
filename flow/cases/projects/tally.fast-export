# The declaration of the project tally, read by the engine as it starts.

tree = "design/"

[files.guide]
path = "AGENTS.md"

[files.constitution]
path = "design/constitution.md"

[files.tree_rules]
path = "design/README.md"

[project]
research = "research/"
test_names = '''
An agent names to `run_tests` a test by the name its JUnit result gives it, as it is: a Rust test by its name as nextest
gives it (`tests::a_row`: the test binary is no part of it), and a page test by its describes and its title joined by
` > ` (`a describe > its title`), as vitest lists it. Only an exact name names a test: a binary, a module, a file or
a describe alone names none.'''

[tests]
paths = [":(glob)crates/**/tests/**", ":(glob)crates/**/tests.rs"]
expected = []

[ci.fast]
workflow = "fast.yml"
runner = "ubuntu-latest"
checks = ["lint"]

[ci.full]
workflows = ["ci.yml"]
runner = "ubuntu-latest"
too_long = "1h"

[protected]
paths = ["AGENTS.md", "design/constitution.md", "design/principles/", "flow/", ".github/workflows/"]

[heavy]
commands = ["cargo", "rustc", "rustup", "npm", "npx", "node --test", "tsc", "vitest", "hyperfine"]

