//! An amount of money, in the ledger's one currency (decision amounts-are-floats).

/// An amount, positive for what was spent and negative for what came back, such as a refund.
pub type Amount = f64;

/// Reads an amount as the ledger writes it: digits with an optional sign and decimal point, such as `12.50` or `-3`.
pub fn parse(text: &str) -> Result<Amount, String> {
    text.trim()
        .parse::<f64>()
        .map_err(|e| format!("not an amount: {text:?}: {e}"))
}

/// Writes an amount with two decimals, as every report shows it.
pub fn format(amount: Amount) -> String {
    format!("{amount:.2}")
}

